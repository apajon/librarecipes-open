<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.LibraRecipes" parent="Theme.Material3.DayNight">
        <!-- Couleurs principales -->
        <item name="colorPrimary">@color/librarecipes_primary</item>
        <item name="colorPrimaryVariant">@color/librarecipes_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Couleurs secondaires -->
        <item name="colorSecondary">@color/librarecipes_accent</item>
        <item name="colorSecondaryVariant">@color/librarecipes_accent_dark</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Couleurs de surface -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Couleurs d'erreur -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>

        <!-- Status bar -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
    </style>

    <!-- Thème pour l'écran de démarrage -->
    <style name="Theme.LibraRecipes.Splash" parent="Theme.LibraRecipes">
        <item name="android:windowBackground">@color/librarecipes_primary</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
